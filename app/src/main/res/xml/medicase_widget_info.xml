<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget "Estado de la insulina", según las pautas de widgets de Android (Android UI Kit):
    - Tamaño objetivo 4×2 celdas y mínimo 2×2; se puede redimensionar en ambos ejes.
    - El contenido se adapta al tamaño (SizeMode.Responsive en MediCaseWidget).
    - Vista previa y descripción para el selector de widgets.
    - Se redibuja con cada dato nuevo; el refresco periódico (30 min, el mínimo del
      sistema) es solo un respaldo.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/medicase_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
