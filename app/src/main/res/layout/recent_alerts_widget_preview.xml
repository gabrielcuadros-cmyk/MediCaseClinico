<?xml version="1.0" encoding="utf-8"?>
<!--
    Vista previa del widget "Últimas alertas" en el selector de Android 12+.
    Sin alertas inventadas: muestra el título y el estado vacío real.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_alerts"
            android:tint="@color/widget_preview_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/alerts_widget_title"
            android:textColor="@color/widget_preview_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/alerts_widget_empty"
        android:textColor="@color/widget_preview_text_primary"
        android:textSize="12sp" />
</LinearLayout>
