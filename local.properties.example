# ============================================================
# MediCase Clínico - Plantilla de configuración local
# 1. Copia este archivo y renómbralo a "local.properties"
# 2. Rellena tus claves reales (NUNCA subas local.properties a Git)
# ============================================================

# Ruta del Android SDK
sdk.dir=/ruta/a/tu/Android/Sdk

# Todas las claves de abajo son opcionales: el proyecto compila con ellas vacías
# o sin este archivo.

# --- Firebase ---
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=

# --- Estuche BLE MediCase ---
# Vacías: se usan los UUID estándar de Bluetooth SIG (ver hardware/ble-protocol.md):
# servicio 0x1809, temperatura 0x2A1C y batería 0x2A19.
BLE_SERVICE_UUID=
BLE_TEMPERATURE_CHAR_UUID=
BLE_BATTERY_CHAR_UUID=

# --- Broker MQTT del estuche (ver hardware/mqtt-protocol.md) ---
# Con MQTT_HOST y MQTT_TOPIC_PREFIX rellenos, la app recibe los datos por MQTT; vacías,
# usa Bluetooth. Los valores reales van SOLO en local.properties, nunca aquí.
# MQTT_PORT vacío: 1883, o 8883 con MQTT_USE_TLS=true.
# MQTT_USERNAME, MQTT_PASSWORD y MQTT_CASE_ID son para un broker propio: si MQTT_CASE_ID
# tiene valor, los topics quedan bajo <prefijo>/<id del estuche>/.
MQTT_HOST=
MQTT_PORT=
MQTT_USE_TLS=
MQTT_TOPIC_PREFIX=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CASE_ID=
